# Copy to .env for local development in derived projects.
# Never commit .env.

PROJECT_NAME=subcult-os
COMPOSE_PROJECT_NAME=subcult-os

# Optional local Postgres profile used by docker-compose.yml.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# High local host ports avoid common service conflicts.
POSTGRES_PORT=35432
API_PORT=38080
WEB_PORT=38079

APP_ENV=development
API_ADDR=:8080

# Production must override SESSION_SECRET with a non-default value of at least 24 characters.
SESSION_SECRET=dev-session-secret-change-me
# Production requires a base64-encoded 32-byte key kept in the deployment secret store.
# IDENTITY_PROTECTION_KEY=
# During key rotation only, set the retiring key here so in-flight reads and the
# identity-rekey command can still decrypt rows sealed under it. Remove this once
# `make identity-rekey-status` reports zero remaining previous-key rows for every
# table. See docs/runbooks/key-rotation.md.
# IDENTITY_PROTECTION_KEY_PREVIOUS=

# Production should set PUBLIC_WEB_URL to the HTTPS browser origin.
# The web image build also writes it into the link preview image address.
PUBLIC_WEB_URL=http://localhost:38079

# Optional AT Protocol confidential OAuth client. Keep this disabled until the
# start/callback flow and link UI are live-interoperability qualified. The private key is an
# Indigo-compatible multibase P-256 secret and must come from a secret store.
# ATPROTO_OAUTH_ENABLED=false
# ATPROTO_OAUTH_CLIENT_ID=https://os.subcult.tv/api/v1/auth/atproto/client-metadata
# ATPROTO_OAUTH_CALLBACK_URL=https://os.subcult.tv/api/v1/auth/atproto/callback
# ATPROTO_OAUTH_JWKS_URL=https://os.subcult.tv/api/v1/auth/atproto/jwks
# ATPROTO_OAUTH_CLIENT_PRIVATE_KEY=
# ATPROTO_OAUTH_CLIENT_KEY_ID=subcults-1
# During a signing-key transition only, publish the retiring public key alongside
# the current one in the JWKS so in-flight client assertions still validate. The
# private key never signs new assertions once replaced. See
# docs/runbooks/key-rotation.md.
# ATPROTO_OAUTH_CLIENT_PRIVATE_KEY_PREVIOUS=
# ATPROTO_OAUTH_CLIENT_KEY_ID_PREVIOUS=

# Production should provide DATABASE_URL through the deployment secret store.
# DATABASE_URL=postgres://app:change-me@postgres:5432/app?sslmode=require

# Optional Stripe paid-ticketing settings for local testing.
# STRIPE_SECRET_KEY=sk_test_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Optional S3-compatible event media storage. For Almaz/MinIO, point the backend
# at an API route or internal endpoint, not the Authelia-protected console.
# MEDIA_S3_ENDPOINT=https://s3.subcult.tv
# MEDIA_S3_ACCESS_KEY=subcult-os-media
# MEDIA_S3_SECRET_KEY=replace-me
# MEDIA_S3_BUCKET=subcult-os-media
# MEDIA_S3_REGION=us-east-1
# MEDIA_PUBLIC_BASE_URL=https://s3.subcult.tv/subcult-os-media

# Transactional email remains disabled until provider/domain setup is qualified.
MAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
MAIL_REPLY_TO=

# Native app links for verification and recovery emails. Leave empty to keep
# those links in the browser. See docs/development/mobile-app-links.md.
MOBILE_APPLE_APP_IDS=
MOBILE_ANDROID_PACKAGE=
MOBILE_ANDROID_CERT_SHA256=

# AT record projection remains disabled until a stream source is qualified.
AT_PROJECTION_ENABLED=false
# AT_PROJECTION_SOURCE_URL=wss://jetstream.example.invalid/subscribe

# Optional local test database URL.
# TEST_DATABASE_URL=postgres://app:change-me@localhost:35432/app?sslmode=disable

# Private external ticket handoff configuration; empty denies every hostname.
# Use exact hostnames only after the operator has selected a destination.
EXTERNAL_TICKET_ALLOWED_HOSTS=

# Brevo alternative; existing deployments keep Resend by default.
MAIL_PROVIDER=resend
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=
